# Copy this file to `.env` and fill in your real values. app.py reads it
# automatically when it starts.
#
# NEVER commit the real `.env` file -- it's already in .gitignore.

# Master switch: set to "true" once your credentials below are filled
# in and you're ready to sync real data instead of the built-in demo
# mock data.
USE_REAL_APIS=false

# --- Shopify ---
# Get these from: Shopify Admin > Settings > Apps and sales channels >
# Develop apps > (your app) > API credentials
SHOPIFY_SHOP=your-store
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- eBay ---
# Get these from: https://developer.ebay.com > Application Keys, plus
# the OAuth consent flow described in integrations/ebay_client.py
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
# Your eBay username: your own listings can then be imported as-is
# (photos included) on the Add product page. Other sellers' listings
# only ever give facts.
EBAY_SELLER_USERNAME=
# production (default) or sandbox. Sandbox keys only work with sandbox.
EBAY_ENVIRONMENT=production
# For connecting the store's seller account (admin > eBay): the RuName
# from the keyset's User Tokens page. Keep eBay's own confirmation page
# as its "auth accepted URL" (eBay requires HTTPS and doesn't accept
# localhost); on an HTTPS deployment you can use
# https://your-domain/ebay/callback instead.
EBAY_RUNAME=
# Optional: space-separated OAuth scopes, if eBay assigns your keyset a
# different set. Default: the basic scope plus read-only orders and
# inventory.
EBAY_SCOPES=

# --- Amazon SP-API ---
# Get these by registering as a developer in Seller Central, per the
# setup steps in integrations/amazon_sp_api_client.py
SP_API_REFRESH_TOKEN=
SP_API_LWA_APP_ID=
SP_API_LWA_CLIENT_SECRET=
SP_API_AWS_ACCESS_KEY=
SP_API_AWS_SECRET_KEY=
SP_API_ROLE_ARN=
SP_API_SELLER_ID=
# For reading catalog facts by ASIN (Add product page). The AWS keys
# above aren't needed for this: Amazon dropped AWS request signing.
SP_API_MARKETPLACE_ID=ATVPDKIKX0DER
SP_API_REGION=na

# --- Inventory ---
# Your own Shopify store's domain (e.g. yourstore.com): products can then
# be imported from it in full, photos included (Add product page).
STORE_DOMAIN=
# Set to false to start with an empty inventory instead of demo data.
# Delete backend/inventory.db after changing this.
DEMO_DATA=true

# --- AI customer support ---
# Either AI works; set one key. Without any, the chat widget answers
# only from the knowledge articles.
# Claude: a key from console.anthropic.com (billed per use).
ANTHROPIC_API_KEY=
# Gemini: a key from aistudio.google.com. The free tier works, but Google
# uses free-tier content to improve its products, so turn on billing
# before real customers chat (paid-tier content isn't used that way).
GEMINI_API_KEY=
# Optional: claude or gemini, if both keys are set (default: claude).
SUPPORT_PROVIDER=
# Optional: the model. Defaults: claude-haiku-4-5-20251001 for Claude
# (claude-sonnet-5-5 for higher quality), gemini-2.5-flash for Gemini.
SUPPORT_MODEL=

# --- Notifications when a customer asks for a person ---
# Either or both. Slack: an Incoming Webhook URL. Email: an SMTP account
# (Gmail needs an app password) and where to send the message.
SLACK_WEBHOOK_URL=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The site's address, used for the link in notifications.
SITE_URL=http://127.0.0.1:5050

# --- Database ---
# Leave empty to use SQLite (the file backend/inventory.db, nothing to
# install). To use PostgreSQL, set the connection address, for example
# with Postgres.app on a Mac:
# DATABASE_URL=postgresql://localhost/channel_ledger
DATABASE_URL=
# Optional: a separate, empty PostgreSQL database for running the tests
# against PostgreSQL. Tests never use DATABASE_URL.
# TEST_DATABASE_URL=postgresql://localhost/channel_ledger_test

# --- Admin sign-in ---
# Password for the /admin area. If left empty, a new random password is
# generated each time the server starts and printed in the terminal.
ADMIN_PASSWORD=
# Signs the login cookie. If empty, a random key is used per run (you'll
# need to sign in again after restarting). Set a long random value when
# deploying.
SECRET_KEY=
